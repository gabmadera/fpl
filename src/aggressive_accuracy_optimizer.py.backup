                'differential_threshold': 0.25,    # 25% ownership threshold
                'risk_multiplier': 0.8,
                'captain_confidence_min': 0.8,
                'value_weight': 1.2,
                'form_weight': 1.0,
                'fixture_weight': 1.1,
            },
            OptimizationStrategy.BALANCED: {
                'differential_threshold': 0.15,    # 15% ownership threshold
                'risk_multiplier': 1.0,
                'captain_confidence_min': 0.7,
                'value_weight': 1.1,
                'form_weight': 1.1,
                'fixture_weight': 1.0,
            },
            OptimizationStrategy.AGGRESSIVE: {
                'differential_threshold': 0.10,    # 10% ownership threshold
                'risk_multiplier': 1.3,
                'captain_confidence_min': 0.6,
                'value_weight': 1.0,
                'form_weight': 1.3,
                'fixture_weight': 0.9,
            },
            OptimizationStrategy.MAXIMUM: {
                'differential_threshold': 0.05,    # 5% ownership threshold
                'risk_multiplier': 1.5,
                'captain_confidence_min': 0.5,
                'value_weight': 0.9,
                'form_weight': 1.5,
                'fixture_weight': 0.8,
            }
        }

        # File paths
        self.metrics_file = Path("data/optimizer/metrics_history.jsonl")
        self.config_file = Path("data/optimizer/optimizer_config.json")
        self.metrics_file.parent.mkdir(parents=True, exist_ok=True)

        # Setup logging
        self._setup_logging()

        # Load previous metrics
        self._load_metrics_history()

