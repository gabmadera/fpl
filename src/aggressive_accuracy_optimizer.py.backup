class OptimizationStrategy(Enum):
    CONSERVATIVE = "conservative"  # Lower risk, steady gains
    BALANCED = "balanced"         # Moderate risk/reward
    AGGRESSIVE = "aggressive"     # Higher risk, maximum returns
    MAXIMUM = "maximum"          # All-out attack on accuracy


@dataclass
class OptimizerMetrics:
    """Track optimizer performance"""
    timestamp: datetime
    strategy: OptimizationStrategy
    accuracy_target: float
    current_accuracy: float
    captaincy_success_rate: float
    differential_success_rate: float
    value_pick_accuracy: float
    model_confidence: float
    recommendations_made: int
    high_risk_picks: int


class AggressiveAccuracyOptimizer:
    """
    Advanced optimizer for maximum FPL accuracy with aggressive strategies
    """

